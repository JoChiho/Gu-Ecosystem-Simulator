{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "蛊生态模拟器",
  "version": "0.1.0",
  "identifier": "com.jochiho.gu-ecosystem-simulator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "蛊生态模拟器 | Gu Ecosystem Simulator",
        "width": 1100,
        "height": 780,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
